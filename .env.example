# Copy to .env and fill in values for local development.
# .env is gitignored — never commit real credentials.

JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MYPROJECT

SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL=support

SUPPORT_GITHUB_TOKEN=
GITHUB_TEST_ISSUE_REPO=your-org/your-repo

# Only needed for headless (`claude -p`) runs, e.g. the e2e tests. Not
# required for interactive local use if you're already logged in to Claude Code.
ANTHROPIC_API_KEY=
